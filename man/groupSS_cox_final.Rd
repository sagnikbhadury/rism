% Generated by hand to match roxygen comments in R/groupSS_cox.R.
\name{groupSS_cox_final}
\alias{groupSS_cox_final}
\title{MCMC for Cox model with grouped spike-and-slab prior}
\usage{
groupSS_cox_final(time, status, X, g_id,
                   beta_init = NULL, zeta_init = NULL,
                   w_init = NULL, nusq_init = NULL,
                   v0 = 0.01, v1 = 10,
                   a1 = 0.5, a2 = 0.5,
                   alpha_w = 1, beta_w = 1,
                   Nmcmc = 50000, burnin = 20000, thin = 5,
                   mh_sd = 0.15,
                   adapt_mh = TRUE,
                   temper = TRUE,
                   verbose = TRUE,
                   track_logpost = TRUE,
                   seed = NULL)
}
\arguments{
\item{time}{survival times}

\item{status}{event indicator (1=event, 0=censored)}

\item{X}{predictor matrix (n x p), should be standardized}

\item{g_id}{group membership vector, values in 1,...,G}

\item{beta_init}{initial beta. Defaults to small random values.}

\item{zeta_init}{initial zeta. Defaults to Bernoulli(0.5).}

\item{w_init}{initial w. Defaults to mean(zeta_init).}

\item{nusq_init}{initial nu^2. Defaults to 1.}

\item{v0}{spike variance. Default 0.01.}

\item{v1}{slab variance. Default 10.}

\item{a1}{shape hyperparameter for nu^2. Default 0.5.}

\item{a2}{rate hyperparameter for nu^2. Default 0.5.}

\item{alpha_w}{Beta hyperparameter for w. Default 1.}

\item{beta_w}{Beta hyperparameter for w. Default 1.}

\item{Nmcmc}{total MCMC iterations. Default 50000.}

\item{burnin}{burnin length. Default 20000.}

\item{thin}{thinning interval. Default 5.}

\item{mh_sd}{initial MH proposal SD per group. Default 0.15.}

\item{adapt_mh}{adaptive MH during burnin. Default TRUE.}

\item{temper}{use likelihood tempering during early burnin. Default TRUE.}

\item{verbose}{print progress. Default TRUE.}

\item{track_logpost}{track log posterior. Default TRUE.}

\item{seed}{random seed. Default NULL.}
}
\value{
List with MCMC samples and diagnostics: \code{beta}, \code{zeta},
\code{w}, \code{log_posterior}, \code{x_cnames}, \code{g_id},
\code{acceptance_rates_beta}, \code{acceptance_rates_zeta},
\code{mh_sd_final}, and the initial values and hyperparameters used.
}
\description{
Fits a Cox proportional hazards model with a grouped spike-and-slab prior
over predictor groups, via Metropolis-Hastings (beta, zeta) and Gibbs
(nu^2, w) updates, with adaptive proposal scaling and likelihood tempering
during burn-in.
}

% Generated by hand to match roxygen comments in R/groupSS_cox.R.
\name{compute_PIP}
\alias{compute_PIP}
\alias{summarize_beta}
\alias{plot_zeta_trace}
\alias{check_convergence}
\title{Posterior summaries and diagnostics for a groupSS_cox_final fit}
\usage{
compute_PIP(fit)

summarize_beta(fit, prob = 0.95)

plot_zeta_trace(fit, group_names = NULL)

check_convergence(fit)
}
\arguments{
\item{fit}{Output of \code{\link{groupSS_cox_final}}.}

\item{prob}{Credible interval coverage. Default 0.95.}

\item{group_names}{Optional character vector of group labels.}
}
\value{
\code{compute_PIP} returns a named numeric vector of posterior
inclusion probabilities, one per group.

\code{summarize_beta} returns a data frame with one row per predictor:
posterior mean, median, SD, and credible interval.

\code{plot_zeta_trace} is called for its plotting side effect.

\code{check_convergence} requires the \pkg{coda} package and returns
(invisibly) a list with \code{beta_ess}, \code{pip_ess}, and \code{w_ess};
it also plots the log-posterior trace if available and warns if any
effective sample size is below 100.
}
\description{
\code{compute_PIP} computes posterior inclusion probabilities per group.

\code{summarize_beta} computes posterior mean, median, SD, and credible
intervals for each regression coefficient.

\code{plot_zeta_trace} draws a trace plot of the group inclusion indicator
for each group.

\code{check_convergence} computes effective sample sizes and plots the
log-posterior trace.
}
